{
  "name": "@ruxex/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "build": "vite build",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "pnpm lint:biome && pnpm lint:react",
    "lint:biome": "biome lint .",
    "lint:react": "eslint src --max-warnings 0",
    "lint:fix": "biome lint --write . && eslint src --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage:runtime": "python3 scripts/stage-ruxex-package.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "daisyui": "^5.1.7",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
