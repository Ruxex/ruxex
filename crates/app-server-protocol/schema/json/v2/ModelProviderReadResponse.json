{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelProviderAuthField": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "secret"
      ],
      "type": "object"
    },
    "ProviderAuthStatus": {
      "description": "Authentication state for the currently selected model provider.",
      "oneOf": [
        {
          "description": "The provider has usable credentials.",
          "enum": [
            "authenticated"
          ],
          "type": "string"
        },
        {
          "description": "The provider requires credentials, but none are currently available.",
          "enum": [
            "unauthenticated"
          ],
          "type": "string"
        },
        {
          "description": "Provider configuration or credentials are invalid.",
          "enum": [
            "invalid"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "authFields": {
      "items": {
        "$ref": "#/definitions/ModelProviderAuthField"
      },
      "type": "array"
    },
    "authStatus": {
      "$ref": "#/definitions/ProviderAuthStatus"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "authFields",
    "authStatus",
    "id",
    "name"
  ],
  "title": "ModelProviderReadResponse",
  "type": "object"
}