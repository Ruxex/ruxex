{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProviderAuthStatus": {
      "description": "Authentication state for the mounted model provider.",
      "oneOf": [
        {
          "description": "The provider has usable credentials.",
          "enum": [
            "authenticated"
          ],
          "type": "string"
        },
        {
          "description": "The provider requires credentials, but none are currently available.",
          "enum": [
            "unauthenticated"
          ],
          "type": "string"
        },
        {
          "description": "Provider configuration or credentials are invalid.",
          "enum": [
            "invalid"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "authStatus": {
      "$ref": "#/definitions/ProviderAuthStatus"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "authStatus",
    "id",
    "name"
  ],
  "title": "ModelProviderReadResponse",
  "type": "object"
}