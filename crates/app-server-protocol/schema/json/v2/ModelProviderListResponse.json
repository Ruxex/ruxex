{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelProviderAuthField": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "secret"
      ],
      "type": "object"
    },
    "ModelProviderListEntry": {
      "properties": {
        "active": {
          "type": "boolean"
        },
        "authFields": {
          "items": {
            "$ref": "#/definitions/ModelProviderAuthField"
          },
          "type": "array"
        },
        "authStatus": {
          "$ref": "#/definitions/ProviderAuthStatus"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "active",
        "authFields",
        "authStatus",
        "id",
        "name"
      ],
      "type": "object"
    },
    "ProviderAuthStatus": {
      "description": "Authentication state for the currently selected model provider.",
      "oneOf": [
        {
          "description": "The provider has usable credentials.",
          "enum": [
            "authenticated"
          ],
          "type": "string"
        },
        {
          "description": "The provider requires credentials, but none are currently available.",
          "enum": [
            "unauthenticated"
          ],
          "type": "string"
        },
        {
          "description": "Provider configuration or credentials are invalid.",
          "enum": [
            "invalid"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "activeProviderId": {
      "type": [
        "string",
        "null"
      ]
    },
    "providers": {
      "items": {
        "$ref": "#/definitions/ModelProviderListEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "providers"
  ],
  "title": "ModelProviderListResponse",
  "type": "object"
}